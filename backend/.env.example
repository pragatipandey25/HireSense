# HireSense AI - Backend Environment Configuration Template
# Copy this file to .env and provide your actual values

# Server Port
PORT=5000

# Environment Mode
NODE_ENV=development

# MongoDB Connection String (Atlas SRV or Local MongoDB)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/hiresense_ai?retryWrites=true&w=majority

# JWT Signing Secret (Minimum 32 random characters recommended)
JWT_SECRET=replace_with_a_secure_jwt_secret_key_min_32_chars

# Google Gemini API Key (Gemini 2.0 Flash)
GEMINI_API_KEY=your_gemini_api_key_here
